@startuml
skinparam componentStyle uml2
skinparam Linetype ortho

package "Flujo de Autenticación" {
  [LoginPage] --> [LoginForm]
  [LoginForm] --> [Redirige a Dashboard] : "Inicio de sesión exitoso"
  [LoginForm] ..> [FirstLoginModal] : "en el primer login"
}

package "Gestión de Perfil" {
  [ProfilePage] --> [ProfileHeader]
  [ProfilePage] --> [ProfileStats]
  [ProfilePage] --> [ProfileForm]
  [ProfilePage] ..> [PasswordChangeModal] : "puede abrir"
}

[Redirige a Dashboard] ~> [ProfilePage] : "navega a"
@enduml
